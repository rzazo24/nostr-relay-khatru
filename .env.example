# Copia este archivo a .env y ajusta lo que necesites. Todo excepto RELAY_DOMAIN es
# opcional: si no lo pones, se usa el valor por defecto indicado.

# Dominio público del relé (apunta su DNS a este servidor). Obligatorio con Docker.
RELAY_DOMAIN=relay.example.com

# --- Documento NIP-11 (lo que ven los clientes) ---
# RELAY_NAME=nostr-relay-khatru
# RELAY_DESCRIPTION=A small general-purpose Nostr relay built with khatru
# RELAY_PUBKEY=          # clave pública (hex, 64 caracteres) de quien lo administra
# RELAY_CONTACT=         # correo, URL o similar

# --- Límites por evento ---
# RELAY_MAX_CONTENT_LENGTH=65536      # caracteres del content
# RELAY_MAX_EVENT_TAGS=2000           # número de tags
# RELAY_MAX_TAG_VALUE_BYTES=1024      # bytes de cada valor de un tag
# RELAY_MAX_FUTURE_SKEW_SECONDS=900   # cuánto puede adelantarse created_at (0 = sin límite)
# RELAY_ALLOWED_KINDS=                # lista de kinds separada por comas; vacío = todos

# --- Límites por consulta ---
# RELAY_MAX_LIMIT=500                 # máximo de eventos por filtro

# --- Velocidad por IP (tokens por minuto y ráfaga) ---
# RELAY_EVENTS_PER_MINUTE=30
# RELAY_EVENTS_BURST=60
# RELAY_REQS_PER_MINUTE=60
# RELAY_REQS_BURST=180
# RELAY_CONNS_PER_MINUTE=20
# RELAY_CONNS_BURST=60
