# TLS automático (Let's Encrypt) y proxy inverso al relé. El dominio sale de
# RELAY_DOMAIN (.env). Caddy pasa X-Forwarded-For, que el relé usa para aplicar los
# límites de velocidad por IP real de cada cliente.
{$RELAY_DOMAIN} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# la misma URL ("/") devuelve cosas distintas según Accept (página, NIP-11, WebSocket)
		+Vary Accept
	}

	# Archivos estáticos: icono del relé (RELAY_ICON=/icon.png) y recursos de la página
	@static path /icon.png /icon.svg /landing.css /landing.js
	handle @static {
		root * /srv/static
		file_server
	}

	# Página de presentación: para cualquier GET de la raíz que NO sea un cliente de Nostr
	# (Accept: application/nostr+json, NIP-11), ni un WebSocket, ni una llamada POST de la API
	# NIP-86. Así también la ven un navegador sin Accept, curl o un monitor de disponibilidad.
	@page {
		method GET HEAD
		path /
		not header Accept *application/nostr+json*
		not header Upgrade *
		not header Connection *pgrade*
	}
	handle @page {
		root * /srv/static
		rewrite * /index.html
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		file_server
	}

	# Panel de control: la API la atiende el relé (protegida por firma Nostr del dueño); la
	# interfaz son archivos estáticos con una política de contenido estricta y sin caché.
	handle /admin/api/* {
		reverse_proxy relay:3334
	}
	@adminpage path /admin /admin/ /admin/admin.js /admin/admin.css
	handle @adminpage {
		root * /srv/static
		@adminroot path /admin /admin/
		rewrite @adminroot /admin/index.html
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		file_server
	}

	handle {
		reverse_proxy relay:3334
	}
}
